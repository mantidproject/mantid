# Code-only graphify run: every docs, paper, image and video file is ignored below,
# so graphify extracts code with its local AST parser and makes no LLM calls.
#
# Scope: the source that ends up in the main `mantid` conda package
# (conda/recipes/mantid). That recipe configures with MANTID_FRAMEWORK_LIB=BUILD,
# MANTID_QT_LIB=OFF, ENABLE_WORKBENCH=OFF and ENABLE_DOCS=OFF, so only
# Framework/ and scripts/ (installed whole, minus test/) are packaged.

# Allowlist: ignore every top-level entry, then re-include the packaged ones
/*
!/Framework/
!/scripts/

# Framework parts that are not built by the recipe
# (Framework/MPIAlgorithms/ is kept: it is built here and shipped as mantidmpi)
/Framework/Examples/
/Framework/Doxygen/

# gSOAP generated code for ICat (plus the two wrappers that only #include it)
/Framework/ICat/src/GSoap/
/Framework/ICat/inc/MantidICat/GSoap/
/Framework/ICat/src/ICat4/GSoapGenerated/
/Framework/ICat/inc/MantidICat/ICat4/GSoapGenerated/
/Framework/ICat/src/GSoap.cpp
/Framework/ICat/src/ICat4/ICat4GSoapGenerated.cpp

# Vendored FlatBuffers library and flatc-generated Kafka schema headers
/Framework/LiveData/src/Kafka/private/Schema/

# Tests
test/
tests/
TestHelpers/

# Remaining document types (graphify DOC_EXTENSIONS), e.g. READMEs and CMakeLists.txt
*.md
*.mdx
*.qmd
*.skill
*.txt
*.rst
*.html
*.j2
*.jinja
*.jinja2

# Papers, images, video/audio (graphify's PAPER/IMAGE/VIDEO_EXTENSIONS)
*.pdf
*.png
*.PNG
*.jpg
*.jpeg
*.gif
*.webp
*.svg
*.mp4
*.mov
*.webm
*.mkv
*.avi
*.m4v
*.mp3
*.wav
*.m4a
*.ogg
