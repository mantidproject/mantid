digraph isisPowderSaveFocusedBanks{
    label="ISISPowder - Save Focused Banks"
    $global_style

    // **Labels
    label_saveFocusedGeneric                    [label="Save Focused Banks - Generic"]
    label_saveFocusedPearl                      [label="Save Focused Banks - PEARL"]

    // **Parameters
    subgraph params {
        $param_style

        param_processedBanksGeneric             [label="Processed banks"]

        // PEARL params
        param_focusModePearl                    [label="User param: focus_mode"]
    }

    // **Processes (inc. bespoke inst steps)
    subgraph {
        $process_style

        // Bespoke
        proc_focusModeAllPearl                  [label="Focus mode: All"]
        proc_focusModeGroupsPearl               [label="Focus mode: Groups"]
        proc_focusModeTransPearl                [label="Focus mode: Trans"]
        proc_focusModeModsPearl                 [label="Focus mode: Mods"]
    }

    // **Algorithms
    subgraph algorithms{
        $algorithm_style

        // Generic
        alg_ConvertUnitsDSpacingGeneric         [label="Convert Units: dSpacing\n (grouped as <run>-ResultD)"]
        alg_ConvertUnitsTOFGeneric              [label="Convert Units: TOF\n (grouped as <run>-ResultTOF)"]
        alg_SaveGSSGeneric                      [label="Save GSS - TOF"]
        alg_SaveNexusProcessedGeneric           [label="Save Nexus Processed - TOF"]
        alg_SaveXyeDSpacingGeneric              [label="Save Focused XYE - dSpacing"]
        alg_SaveXyeTofGeneric                   [label="Save Focused XYE - TOF"]
    }

    // **Decisions
    subgraph decisions{
        $decision_style

        // Pearl
        if_focusModePearl                       [label="If: focus mode"]
    }

    // **Graph layout - Generic method (GEM, HRPD, OSIRIS, POLARIS)
    subgraph SaveFocusedBanksGeneric{
        label_saveFocusedGeneric        -> param_processedBanksGeneric
        param_processedBanksGeneric     -> alg_ConvertUnitsDSpacingGeneric
        param_processedBanksGeneric     -> alg_ConvertUnitsTOFGeneric

        // GSS and NXS
        alg_ConvertUnitsTOFGeneric      -> alg_SaveGSSGeneric
        alg_SaveGSSGeneric              -> alg_SaveNexusProcessedGeneric

        // XYE
        alg_ConvertUnitsDSpacingGeneric -> alg_SaveXyeDSpacingGeneric   [label="One file per bank"]
        alg_SaveNexusProcessedGeneric   -> alg_SaveXyeTofGeneric        [label="One file per bank"]
    }

    subgraph SaveFocusedBankPearl{
        // Determine focus mode from user input
        label_saveFocusedPearl          -> if_focusModePearl
        param_focusModePearl            -> if_focusModePearl

        // Switch to various sub-processes detailed in different file
        if_focusModePearl               -> proc_focusModeAllPearl       [label="'all'"]
        if_focusModePearl               -> proc_focusModeGroupsPearl    [label="'groups'"]
        if_focusModePearl               -> proc_focusModeModsPearl      [label="'mods' or custom\n grouping without 14 groups"]
        if_focusModePearl               -> proc_focusModeTransPearl     [label="'trans'"]
    }
}
