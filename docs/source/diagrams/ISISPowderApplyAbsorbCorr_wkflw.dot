digraph isisPowderApplyAbsorbCorr{
    label="ISISPowder - Apply absorption corrections"
    $global_style

    // **Labels
    label_GEM_POLARIS                       [label="Apply absorption corrections - GEM / POLARIS"]
    label_PEARL                             [label="Apply absorption corrections - PEARL\n (vanadium only)"]

    // **Parameters
    subgraph params {
        $param_style

        // General
        param_advVanMayersInputs            [label="Adv config: Vanadium sample details\n (chemical formula, cylinder geometry,\n number density)"]
        param_userSampleDetails             [label="User param: Sample details\n (set with 'set_sample_details')"]
        param_multipleScattering            [label="User/Adv config: multiple_scattering"]

        // PEARL
        param_genAbsorb                     [label="User param: gen_absorb"]
        param_absorbOutFile                 [label="User param: absorb_corrections_out_filename"]
        param_advAbsFilename                [label="Adv config: Vanadium absorption file"]
    }

    // **Algorithms
    subgraph algorithms{
        $algorithm_style

        // GEM / POLARIS
        alg_GEM_maskDetector                [label="GEM: Mask detectors 1-100"]
        alg_POLARIS_maskDetector            [label="POLARIS: Mask detectors 1-54"]
        alg_SetSample                       [label="Set Sample: cylinder"]
        alg_ConvertUnitsTOF                 [label="Convert Units: TOF"]
        alg_MayersSampleCorr                [label="Mayers Sample Correction"]
        alg_ConvertUnitsOriginal            [label="Convert Units: original units"]

        // PEARL
        alg_PEARL_Clone                     [label="Clone Workspace"]
        alg_PEARL_ConvertUnitsWavelength    [label="Convert Units: Wavelength"]
        alg_PEARL_CreateSampleShape         [label="Create Sample Shape: sphere"]
        alg_PEARL_AbsorptionCorrection      [label="Absorption Correction"]
        alg_PEARL_SaveNexus                 [label="Save Nexus"]
        alg_PEARL_Load                      [label="Load"]
        alg_PEARL_ConvertUnitsAbsorb        [label="Convert Units:\n Van ws to absorption ws units"]
        alg_PEARL_ExtractSpectra            [label="Extract Spectra:\n Keep common detectors only"]
        alg_PEARL_RebinToWorkspace          [label="Rebin To Workspace:\n Absorb ws to match Van ws"]
        alg_PEARL_Divide                    [label="Divide: Van ws / Absorb ws"]
        alg_PEARL_ConvertUnitsOriginal      [label="Convert Units: original units"]
    }

    // **Decisions
    subgraph decisions{
        $decision_style

        // GEM / POLARIS
        if_isVanadium                       [label="If: Is Vanadium"]
        if_GEM_or_POLARIS                   [label="Instrument"]

        // PEARL
        if_PEARL_genAbsorb                  [label="If: gen_absorb"]
    }

    // **Graph layout for GEM / POLARIS
    subgraph ApplyAbsorbCorrGemPolaris{
        label_GEM_POLARIS               ->  if_isVanadium

        // Is Vanadium
        if_isVanadium                   ->  if_GEM_or_POLARIS       [label="True"]
        if_GEM_or_POLARIS               ->  alg_GEM_maskDetector    [label="GEM"]
        if_GEM_or_POLARIS               ->  alg_POLARIS_maskDetector [label="POLARIS"]
        alg_GEM_maskDetector            ->  alg_SetSample
        alg_POLARIS_maskDetector        ->  alg_SetSample
        param_advVanMayersInputs        ->  alg_SetSample

        // Not Vanadium
        if_isVanadium                   ->  alg_SetSample           [label="False"]
        param_userSampleDetails         ->  alg_SetSample

        // Mayers correction is done in TOF
        alg_SetSample                   ->  alg_ConvertUnitsTOF
        alg_ConvertUnitsTOF             ->  alg_MayersSampleCorr
        param_multipleScattering        ->  alg_MayersSampleCorr    [label="Vanadium only"]
        alg_MayersSampleCorr            ->  alg_ConvertUnitsOriginal
    }

    // **Graph layout for PEARL
    subgraph ApplyAbsorbPearl{
        label_PEARL                     ->  if_PEARL_genAbsorb
        param_genAbsorb                 ->  if_PEARL_genAbsorb

        // Generate absorption corrections
        if_PEARL_genAbsorb              ->  alg_PEARL_Clone             [label="True"]
        alg_PEARL_Clone                 ->  alg_PEARL_ConvertUnitsWavelength
        alg_PEARL_ConvertUnitsWavelength -> alg_PEARL_CreateSampleShape
        alg_PEARL_CreateSampleShape     ->  alg_PEARL_AbsorptionCorrection
        alg_PEARL_AbsorptionCorrection  ->  alg_PEARL_SaveNexus
        param_absorbOutFile             ->  alg_PEARL_SaveNexus

        // Load previously calculated absorption corrections
        if_PEARL_genAbsorb              ->  alg_PEARL_Load              [label="False"]
        param_advAbsFilename            ->  alg_PEARL_Load

        // Match units, detectors and binning then divide
        alg_PEARL_SaveNexus             ->  alg_PEARL_ConvertUnitsAbsorb
        alg_PEARL_Load                  ->  alg_PEARL_ConvertUnitsAbsorb
        alg_PEARL_ConvertUnitsAbsorb    ->  alg_PEARL_ExtractSpectra
        alg_PEARL_ExtractSpectra        ->  alg_PEARL_RebinToWorkspace
        alg_PEARL_RebinToWorkspace      ->  alg_PEARL_Divide
        alg_PEARL_Divide                ->  alg_PEARL_ConvertUnitsOriginal
    }
}
