digraph isisPowderCreateVanadium{
    label="ISISPowder - 'create_vanadium'"
    $global_style

    // **Labels
    label_start                     [label="Start ISISPowder 'create_vanadium'"]

    // **Parameters
    subgraph params {
        $param_style

        // User input
        param_apply_absorb              [label="User param: do_absorb_corrections"]

        // From user provided files
        param_calFileName               [label="Calibration (offset) file"]
        param_calMapping                [label="Calibration mapping file"]
        param_emptyRunNumber            [label="Empty run number(s)"]
        param_vanadiumRunNumber         [label="Vanadium run number(s)"]

        // From advanced config
        param_groupingCalFile           [label="Adv config: Grouping file"]
        param_rawTOFCropValues          [label="Adv config: Raw TOF cropping values"]
        param_vanadiumTOFCropValues     [label="Adv config: Vanadium TOF cropping values"]
        param_vanadiumSplineCoefficient [label="Adv config: Vanadium spline coefficient"]

        // Output files
        param_summedEmptyFile           [label="Summed empty instrument file"]
        param_splinedVanFile            [label="Splined vanadium file"]
    }

    // **Processes (inc. bespoke inst steps)
    subgraph {
        $process_style

        // Common
        proc_LoadCurrentNormWS_van      [label="Load current normalised workspace(s)\n InputMode=Summed"]
        proc_LoadCurrentNormWS_empty    [label="Load current normalised workspace(s)\n InputMode=Summed"]

        // Bespoke
        proc_InstCreateSolidAngle       [label="Inst specific: Create solid angle corrections\n (HRPD only)"]
        proc_InstApplyAbsorbCorr        [label="Inst specific: Apply absorption corrections"]
        proc_InstMaskPeaks              [label="Inst specific: Mask / strip Bragg peaks\n in vanadium data"]
        proc_InstSaveFocused            [label="Inst specific: Save focused banks"]
        proc_InstSolidAngle             [label="Inst specific: Divide by solid angle corrections\n (HRPD only)"]
    }

    // **Algorithms
    subgraph algorithms{
        $algorithm_style

        alg_ApplyDiffCal                [label="ApplyDiffCal"]
        alg_ClearDiffCal                [label="ApplyDiffCal: ClearCalibration"]
        alg_ConvertUnitsDSpacing        [label="Convert Units: dSpacing"]
        alg_CropRawTOF                  [label="Crop data to expected TOF"]
        alg_CropVanTOF                  [label="Crop banks to vanadium TOF range"]
        alg_DiffractionFocusing         [label="Diffraction Focussing"]
        alg_ExtractWsSpectra            [label="Extract spectra into individual banks"]
        alg_SaveNexusEmpty              [label="Save Nexus"]
        alg_SaveNexusSpline             [label="Save Nexus"]
        alg_SetSampleMaterial           [label="Set Sample Material: V"]
        alg_SplineVanadium              [label="Spline Background"]
        alg_Subtract_van_empty          [label="Subtract: vanadium - empty"]
    }

    // **Decisions
    subgraph decisions{
        $decision_style

        if_subtract_empty               [label="If: subtract empty instrument"]
        if_apply_absorb                 [label="If: absorb corrections"]
    }

    // **Graph layout
    subgraph ISISPwd_create_van {
        // Load and sum vanadium runs
        label_start                     ->      param_calMapping
        param_calMapping                ->      param_vanadiumRunNumber
        param_vanadiumRunNumber         ->      proc_LoadCurrentNormWS_van
        proc_LoadCurrentNormWS_van      ->      proc_InstCreateSolidAngle
        proc_InstCreateSolidAngle       ->      if_subtract_empty

        // Load, sum and subtract empty
        if_subtract_empty               ->      proc_LoadCurrentNormWS_empty  [label="True"]
        param_calMapping                ->      param_emptyRunNumber
        param_emptyRunNumber            ->      proc_LoadCurrentNormWS_empty
        proc_LoadCurrentNormWS_empty    ->      alg_SaveNexusEmpty
        alg_SaveNexusEmpty              ->      param_summedEmptyFile
        alg_SaveNexusEmpty              ->      alg_Subtract_van_empty

        // Crop to expected raw TOF
        if_subtract_empty               ->      alg_CropRawTOF              [label="False"]
        alg_Subtract_van_empty          ->      alg_CropRawTOF
        param_rawTOFCropValues          ->      alg_CropRawTOF

        // Apply absorption corrections
        alg_CropRawTOF                  ->      if_apply_absorb
        param_apply_absorb              ->      if_apply_absorb
        if_apply_absorb                 ->      proc_InstApplyAbsorbCorr    [label="True"]
        if_apply_absorb                 ->      alg_SetSampleMaterial       [label="False"]

        // Align
        proc_InstApplyAbsorbCorr        ->      alg_ApplyDiffCal
        alg_SetSampleMaterial           ->      alg_ApplyDiffCal
        param_calMapping                ->      param_calFileName
        param_calFileName               ->      alg_ApplyDiffCal
        alg_ApplyDiffCal                ->      alg_ConvertUnitsDSpacing
        alg_ConvertUnitsDSpacing        ->      proc_InstSolidAngle

        // Focusing
        proc_InstSolidAngle             ->      alg_DiffractionFocusing
        param_groupingCalFile           ->      alg_DiffractionFocusing
        alg_DiffractionFocusing         ->      alg_ClearDiffCal

        // Split into banks and crop
        alg_ClearDiffCal                ->      alg_ExtractWsSpectra
        alg_ExtractWsSpectra            ->      alg_CropVanTOF
        param_vanadiumTOFCropValues     ->      alg_CropVanTOF

        // Save focused (unsplined) vanadium
        alg_CropVanTOF                  ->      proc_InstSaveFocused

        // Spline the vanadium
        alg_CropVanTOF                  ->      proc_InstMaskPeaks          [label="If: do_spline"]
        proc_InstMaskPeaks              ->      alg_SplineVanadium
        param_vanadiumSplineCoefficient ->      alg_SplineVanadium
        alg_SplineVanadium              ->      alg_SaveNexusSpline
        alg_SaveNexusSpline             ->      param_splinedVanFile
    }

}
