</parameter>
<parameter name="Workflow.Monitor1-Area" >
  <value val="1.276e-3" />
</parameter>
<parameter name="Workflow.Monitor1-Thickness" >
  <value val="0.025" />
</parameter>
<parameter name="Workflow.Monitor1-Attenuation" >
  <value val="8.3" />
</parameter>
<parameter name="Workflow.Monitor1-ScalingFactor">
