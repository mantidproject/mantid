<?xml version="1.0" encoding="UTF-8" ?>
<parameter-file instrument = "OSIRIS" valid-from = "2026-05-05 00:00:00" valid-to = "2100-01-31 23:59:59">

<component-link name = "OSIRIS">

<!-- The silicon analyser is read out as eight hardware elements per pixel, which the electronics sum into a single
     spectrum, so a data file's spectrum-detector table gives every silicon spectrum eight detector IDs from a
     numbering space this definition does not use. This tells the ISIS loaders to map those spectra to the detector
     of the same ID instead. Spectra whose detectors this definition does contain are left as the file records them,
     so runs taken with the graphite analyser are unaffected, as is any run taken once the electronics and this
     definition agree again. -->
<parameter name="spectra-map-source" type="string">
  <value val="instrument"/>
</parameter>

<parameter name="deltaE-mode" type="string">
  <value val="indirect"/>
</parameter>

<parameter name="analysers" type="string">
  <value val="graphite,silicon,diffraction" />
</parameter>

<parameter name="refl-graphite" type="string">
  <value val="002,004" />
</parameter>

<parameter name="refl-silicon" type="string">
  <value val="111,333" />
</parameter>

<parameter name="refl-diffraction" type="string">
  <value val="diffonly,diffspec" />
</parameter>

